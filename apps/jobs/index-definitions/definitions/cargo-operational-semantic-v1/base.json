{
  "aliases": {
    "cargo-operational-semantic": {}
  },
  "mappings": {
    "dynamic": "strict",
    "runtime": {
      "_captions_line": {
        "type": "keyword",
        "script": {
          "source": "emit(\"מזהה~שם קובץ~תיאור~בעלים\")",
          "lang": "painless"
        }
      },
      "_source_link": {
        "type": "keyword",
        "script": {
          "source": "emit('https://cargo.idf.cts/#/shortcut/file/' + params[\"_source\"][\"id\"])",
          "lang": "painless"
        }
      },
      "_title_line": {
        "type": "keyword",
        "script": {
          "source": "emit(params[\"_source\"][\"id\"]+\"~\"+params[\"_source\"][\"name\"]+\"~\"+params[\"_source\"][\"description\"]+\"~\"+params[\"_source\"][\"holder\"])",
          "lang": "painless"
        }
      }
    },
    "properties": {
      "__chunking_version": {
        "type": "keyword"
      },
      "__embedding_version": {
        "type": "keyword"
      },
      "__metadata_fields": {
        "type": "keyword"
      },
      "__semantic_field": {
        "type": "keyword"
      },
      "chunk_content": {
        "type": "text",
        "term_vector": "with_positions_offsets",
        "analyzer": "default",
        "search_analyzer": "idf_acronyms_search_analyzer"
      },
      "chunk_order": {
        "type": "integer"
      },
      "created": {
        "type": "date"
      },
      "delete_date": {
        "type": "date"
      },
      "description": {
        "type": "text",
        "term_vector": "with_positions_offsets"
      },
      "embedding": {
        "type": "dense_vector",
        "dims": 1024,
        "index": true,
        "similarity": "cosine",
        "index_options": {
          "type": "int8_hnsw",
          "m": 16,
          "ef_construction": 100
        }
      },
      "labels": {
        "properties": {
          "created": {
            "type": "date"
          },
          "group_id": {
            "type": "integer"
          },
          "group_name": {
            "type": "keyword"
          },
          "label_id": {
            "type": "integer"
          },
          "label_name": {
            "type": "keyword"
          }
        }
      },
      "holder": {
        "type": "keyword"
      },
      "id": {
        "type": "integer"
      },
      "is_verified": {
        "type": "boolean"
      },
      "last_modified": {
        "type": "date"
      },
      "name": {
        "type": "text",
        "term_vector": "with_positions_offsets"
      },
      "parent_id": {
        "type": "keyword"
      },
      "path": {
        "type": "text",
        "term_vector": "with_positions_offsets"
      },
      "path_id": {
        "type": "text",
        "term_vector": "with_positions_offsets"
      },
      "path_list": {
        "type": "text",
        "term_vector": "with_positions_offsets"
      },
      "reality_id": {
        "type": "integer"
      },
      "reality_type": {
        "type": "keyword"
      },
      "s3_bucket": {
        "type": "text",
        "term_vector": "with_positions_offsets"
      },
      "s3_key": {
        "type": "text",
        "term_vector": "with_positions_offsets"
      },
      "type": {
        "type": "keyword"
      },
      "ver_last_modified": {
        "type": "date"
      }
    }
  },
  "settings": {
    "index": {
      "routing": {
        "allocation": {
          "include": {
            "_tier_preference": "data_content"
          }
        }
      },
      "analysis": {
        "filter": {
          "idf_acronyms_filter": {
            "type": "synonym_graph",
            "updateable": "true",
            "synonyms_set": "idf_acronyms"
          }
        },
        "analyzer": {
          "dot_split_analyzer": {
            "filter": [
              "lowercase"
            ],
            "char_filter": [
              "dot_to_space"
            ],
            "type": "custom",
            "tokenizer": "whitespace"
          },
          "default": {
            "filter": [
              "lowercase"
            ],
            "char_filter": [
              "dot_to_space"
            ],
            "type": "custom",
            "tokenizer": "whitespace"
          },
          "idf_acronyms_search_analyzer": {
            "filter": [
              "lowercase",
              "idf_acronyms_filter"
            ],
            "char_filter": [
              "dot_to_space"
            ],
            "type": "custom",
            "tokenizer": "whitespace"
          }
        },
        "char_filter": {
          "dot_to_space": {
            "pattern": "\\.",
            "type": "pattern_replace",
            "replacement": " "
          }
        }
      }
    }
  }
}
