{
  "aliases": {
    "cargo-my-storage-lexical": {}
  },
  "mappings": {
    "dynamic": "strict",
    "runtime": {
      "_captions_line": {
        "type": "keyword",
        "script": {
          "lang": "painless",
          "source": "emit('נ\"צ-שם\"' + params[\"_source\"][\"name\"] + ' ' + params[\"_source\"][\"path\"])"
        }
      },
      "_source_link": {
        "type": "keyword",
        "script": {
          "lang": "painless",
          "source": "emit('https://cargo.idf.cts/#/shortcut/file/' + params[\"_source\"][\"id\"])"
        }
      },
      "_title_line": {
        "type": "keyword",
        "script": {
          "lang": "painless",
          "source": "emit(params[\"_source\"][\"id\"]+'-'+params[\"_source\"][\"name\"]+'-'+params[\"_source\"][\"description\"]+'-'+'var_emit(params[\"_source\"][\"holder\"])')"
        }
      }
    },
    "properties": {
      "created": {
        "type": "date"
      },
      "delete_date": {
        "type": "date"
      },
      "description": {
        "type": "text"
      },
      "doc_date_field": {
        "type": "alias",
        "path": "ver_last_modified"
      },
      "holder": {
        "type": "keyword"
      },
      "id": {
        "type": "integer"
      },
      "is_verified": {
        "type": "boolean"
      },
      "labels": {
        "properties": {
          "created": {
            "type": "date"
          },
          "group_id": {
            "type": "integer"
          },
          "group_name": {
            "type": "keyword"
          },
          "label_id": {
            "type": "integer"
          },
          "label_name": {
            "type": "keyword"
          }
        }
      },
      "last_modified": {
        "type": "date"
      },
      "name": {
        "type": "text"
      },
      "path": {
        "type": "text"
      },
      "path_id": {
        "type": "keyword"
      },
      "path_list": {
        "type": "keyword"
      },
      "reality_id": {
        "type": "integer"
      },
      "reality_type": {
        "type": "keyword"
      },
      "s3_bucket": {
        "type": "keyword"
      },
      "s3_key": {
        "type": "keyword"
      },
      "text_content": {
        "type": "text",
        "analyzer": "default",
        "search_analyzer": "idf_acronyms_search_analyzer",
        "term_vector": "with_positions_offsets"
      },
      "type": {
        "type": "keyword"
      },
      "ver_last_modified": {
        "type": "date"
      }
    }
  },
  "settings": {
    "analysis": {
      "char_filter": {
        "dot_to_space": {
          "type": "pattern_replace",
          "pattern": "[}{.,!?;:\\u005b-\\u0060]",
          "replacement": " "
        }
      },
      "filter": {
        "idf_acronyms_filter": {
          "type": "synonym_graph",
          "updateable": "true",
          "synonyms_set": "idf_acronyms"
        }
      },
      "analyzer": {
        "default": {
          "type": "custom",
          "tokenizer": "whitespace",
          "char_filter": [
            "dot_to_space"
          ],
          "filter": [
            "lowercase"
          ]
        },
        "idf_acronyms_search_analyzer": {
          "type": "custom",
          "tokenizer": "whitespace",
          "char_filter": [
            "dot_to_space"
          ],
          "filter": [
            "lowercase",
            "idf_acronyms_filter"
          ]
        }
      }
    }
  }
}