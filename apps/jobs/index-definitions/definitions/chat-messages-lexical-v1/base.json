{
  "aliases": {
    "chat-messages-lexical": {}
  },
  "mappings": {
    "dynamic": "strict",
    "runtime": {
      "_source_link": {
        "type": "keyword",
        "script": {
          "source": "emit('https://chat.idf.cts/' + params[\"_source\"][\"room_type\"] + '/' + params[\"_source\"][\"room_name\"] + '?msg=' + params[\"_source\"][\"id\"])",
          "lang": "painless"
        }
      }
    },
    "properties": {
      "channels": {
        "properties": {
          "name": {
            "type": "text",
            "term_vector": "with_positions_offsets",
            "analyzer": "default",
            "search_analyzer": "idf_acronyms_search_analyzer"
          },
          "id": {
            "type": "keyword"
          }
        }
      },
      "file": {
        "properties": {
          "name": {
            "type": "text",
            "term_vector": "with_positions_offsets",
            "analyzer": "default",
            "search_analyzer": "idf_acronyms_search_analyzer"
          },
          "type": {
            "type": "keyword"
          },
          "id": {
            "type": "keyword"
          }
        }
      },
      "id": {
        "type": "keyword"
      },
      "mentions": {
        "properties": {
          "name": {
            "type": "text",
            "term_vector": "with_positions_offsets",
            "analyzer": "default",
            "search_analyzer": "idf_acronyms_search_analyzer"
          },
          "username": {
            "type": "keyword"
          },
          "id": {
            "type": "keyword"
          },
          "clean_name": {
            "type": "text",
            "term_vector": "with_positions_offsets",
            "analyzer": "default",
            "search_analyzer": "idf_acronyms_search_analyzer"
          }
        }
      },
      "midur_ids": {
        "type": "keyword"
      },
      "msg": {
        "type": "text",
        "term_vector": "with_positions_offsets",
        "analyzer": "default",
        "search_analyzer": "idf_acronyms_search_analyzer"
      },
      "room_id": {
        "type": "keyword"
      },
      "room_name": {
        "type": "keyword"
      },
      "room_type": {
        "type": "keyword"
      },
      "t": {
        "type": "boolean"
      },
      "url_strings": {
        "type": "keyword"
      },
      "user": {
        "properties": {
          "id": {
            "type": "keyword"
          },
          "username": {
            "type": "keyword"
          },
          "name": {
            "type": "text",
            "term_vector": "with_positions_offsets",
            "analyzer": "default",
            "search_analyzer": "idf_acronyms_search_analyzer"
          },
          "clean_name": {
            "type": "text",
            "term_vector": "with_positions_offsets",
            "analyzer": "default",
            "search_analyzer": "idf_acronyms_search_analyzer"
          }
        }
      },
      "sender": {
        "type": "keyword"
      },
      "created_at": {
        "type": "date"
      },
      "updated_at": {
        "type": "date"
      },
      "users_count": {
        "type": "integer"
      },
      "description": {
        "type": "text",
        "term_vector": "with_positions_offsets",
        "analyzer": "default",
        "search_analyzer": "idf_acronyms_search_analyzer"
      },
      "classification": {
        "properties": {
          "triangles": {
            "type": "object",
            "dynamic": true
          }
        }
      }
    }
  },
  "settings": {
    "index": {
      "routing": {
        "allocation": {
          "include": {
            "_tier_preference": "data_content"
          }
        }
      },
      "analysis": {
        "filter": {
          "idf_acronyms_filter": {
            "type": "synonym_graph",
            "updateable": "true",
            "synonyms_set": "idf_acronyms"
          }
        },
        "analyzer": {
          "default": {
            "filter": [
              "lowercase"
            ],
            "char_filter": [
              "dot_to_space"
            ],
            "type": "custom",
            "tokenizer": "whitespace"
          },
          "idf_acronyms_search_analyzer": {
            "filter": [
              "lowercase",
              "idf_acronyms_filter"
            ],
            "type": "custom",
            "tokenizer": "whitespace"
          }
        },
        "char_filter": {
          "dot_to_space": {
            "pattern": "[}{.,!?;:\\u005b-\\u0060]",
            "type": "pattern_replace",
            "replacement": " "
          }
        }
      }
    }
  }
}
