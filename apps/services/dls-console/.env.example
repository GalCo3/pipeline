# dls-console config (copy to .env.local; Next reads it). Flat names — this app is
# one process, so there is no per-client nesting like the Python services use.
#
# NOTE: nothing here is a NEXT_PUBLIC_ var. Every secret is read server-side
# only; the browser talks to this app's own /api routes and never to Mongo or
# Kafka.

# ---- MongoDB: the read path -------------------------------------------------
# The pipeline's own dead letter store. Every service writes here through
# hermes.utils.send_to_dls. The database name is load-bearing: point it
# elsewhere and the console is simply empty.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=hermes
MONGO_USERNAME=root
MONGO_PASSWORD=example
# Collection the services write to (their `dls_collection` setting).
MONGO_DLS_COLLECTION=dls
# TLS material, as paths — same shape as the Kafka block below. Independent of
# each other: a CA alone is server TLS with the password auth above (an internal
# CA that node does not ship), a client certificate alone is x509 against an
# already-trusted issuer.
# MONGO_TLS_CA_PATH=/etc/ssl/mongo/ca.pem
# ONE file: the client certificate and its key concatenated, which is what the
# driver's tlsCertificateKeyFile expects.
# MONGO_TLS_CERT_KEY_PATH=/etc/ssl/mongo/client.pem
#
# x509 = a client certificate and no MONGO_USERNAME/MONGO_PASSWORD. The username
# comes off the certificate's subject DN, which must exist as a user in the
# server's `$external` database. Leave the two credential vars unset (not empty
# strings) and the console authenticates as MONGODB-X509 against `$external`.
#
# Full override — set this and every var above except DATABASE/COLLECTION is
# ignored. Use for replica sets or anything the discrete vars cannot spell.
# MONGO_URI=mongodb://user:pass@host:27017/?authSource=admin

# ---- Kafka: the write path --------------------------------------------------
# Replay produce + consumer-lag metadata. Plain JSON, no Schema Registry: the
# pipeline's topics carry plain JSON, so an SR-framed record would be
# undeserializable to every consumer downstream.
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# TLS material (security protocol SSL). All three are required together.
# KAFKA_SSL_CA_PATH=/etc/ssl/certs/idf-ca-bundle.pem
# KAFKA_SSL_CERT_PATH=/etc/ssl/kafka/client.crt
# KAFKA_SSL_KEY_PATH=/etc/ssl/kafka/client.key
# Seconds to wait for the produce ack before a replay reports 502.
KAFKA_PRODUCE_TIMEOUT=15

# Consumer lag is the *consuming service's own* group on the topic it consumes.
# The group id is derived from the topic: cargo-lexical.files -> cargo-lexical
# -> cargo-lexical-service. A topic that breaks the convention just shows no lag.
LAG_GROUP_ID_TEMPLATE={service}-service

# ---- Auth (OIDC / Keycloak via next-auth) -----------------------------------
# This app is the confidential client: the secret lives here and the browser
# only ever holds a session cookie, so there is no in-browser code exchange.
AUTH_SECRET=dev-only-change-me-32-bytes-minimum
AUTH_KEYCLOAK_ISSUER=http://localhost:8083/realms/dls-console
AUTH_KEYCLOAK_ID=dls-console
AUTH_KEYCLOAK_SECRET=dev-console-secret
# Set when the issuer URL is not reachable from inside the cluster: the browser
# is redirected to AUTH_KEYCLOAK_ISSUER, while token/JWKS calls go here.
# AUTH_KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/dls-console
# Behind a proxy/ingress, next-auth needs to trust the forwarded host.
AUTH_TRUST_HOST=true
# The origin the browser reaches this app on. next-auth builds its callback URL
# from it, and the realm must register exactly `<AUTH_URL>/api/auth/callback/keycloak`
# — a mismatch fails login with `invalid_redirect_uri`. Unset is fine for
# `next dev` (it defaults to the request origin).
# AUTH_URL=http://localhost:8086
# PEM CA bundle for the IdP's TLS cert. Required wherever the SSO is signed by
# an internal CA: without it every login fails on certificate verification,
# because node ships its own trust store. This is node's own variable, read at
# process start — mounting the file without setting this does nothing.
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/idf-ca-bundle.pem

# Dev-only: skip auth entirely and audit every action as DEV_ACTOR.
# NEVER enable in a deployed environment.
DEV_BYPASS=false
DEV_ACTOR=dev@example.com
