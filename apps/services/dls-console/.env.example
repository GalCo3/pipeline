# dls-console config (copy to .env.local; Next reads it). Mongo and Kafka keep
# the Python services' pydantic-settings names (`SECTION__FIELD`, nested with
# `__`) so one cluster's ConfigMap and Secret feed this app and them alike. Only
# this app's own settings (auth, lag, dev switches) are flat.
#
# NOTE: nothing here is a NEXT_PUBLIC_ var. Every secret is read server-side
# only; the browser talks to this app's own /api routes and never to Mongo or
# Kafka.

# ---- MongoDB: the read path -------------------------------------------------
# The pipeline's own dead letter store. Every service writes here through
# hermes.utils.send_to_dls. The database name is load-bearing: point it
# elsewhere and the console is simply empty.
MONGO_CONFIG__LOCAL_HOST=localhost
MONGO_CONFIG__PORT=27017
MONGO_CONFIG__DATABASE=hermes
MONGO_CONFIG__AUTH__USERNAME=root
MONGO_CONFIG__AUTH__PASSWORD=example
# Collection the services write to (their `dls_collection` setting).
DLS_COLLECTION=dls
# TLS material, as paths. CA and client certificate are independent: a CA alone
# is server TLS with the password auth above (an internal CA that node does not
# ship), a client certificate alone is x509 against an already-trusted issuer.
# MONGO_CONFIG__AUTH__LOCAL__CA_PATH=/etc/ssl/mongo/ca.pem
# The certificate. One PEM with the key concatenated (what pymongo takes, so
# what the services' mounts look like) — or the certificate alone, with the key
# named below.
# MONGO_CONFIG__AUTH__LOCAL__CERT_PATH=/etc/ssl/mongo/client.pem
# Only when the key is a separate file. Never on its own: a key with no
# certificate is refused at startup.
# MONGO_CONFIG__AUTH__LOCAL__KEY_PATH=/etc/ssl/mongo/client.key
#
# x509 = a client certificate and no USERNAME/PASSWORD above. The username
# comes off the certificate's subject DN, which must exist as a user in the
# server's `$external` database. Leave the two credential vars unset (not empty
# strings) and the console authenticates as MONGODB-X509 against `$external`.
#
# Full override — set this and every var above except DATABASE/COLLECTION is
# ignored. Use for replica sets or anything the discrete vars cannot spell.
# MONGO_URI=mongodb://user:pass@host:27017/?authSource=admin

# ---- Kafka: the write path --------------------------------------------------
# Replay produce + consumer-lag metadata. Plain JSON, no Schema Registry: the
# pipeline's topics carry plain JSON, so an SR-framed record would be
# undeserializable to every consumer downstream.
CONSUMER_CONFIG__BOOTSTRAP_SERVERS=localhost:9092
# SSL when unset, as in the Python services — a deployed broker speaks TLS, so
# plaintext is something you write down rather than something you forget into.
# The local broker in tools/scripts/sandbox has no TLS, hence this line.
CONSUMER_CONFIG__SECURITY_PROTOCOL=PLAINTEXT
# TLS material (security protocol SSL). All three are required together, and
# SSL without them is refused rather than downgraded. Kafka takes the key as its
# own file — unlike Mongo above, which prefers the two concatenated.
# CONSUMER_CONFIG__SSL__CA_PATH=/etc/ssl/certs/idf-ca-bundle.pem
# CONSUMER_CONFIG__SSL__CERT_PATH=/etc/ssl/kafka/client.crt
# CONSUMER_CONFIG__SSL__KEY_PATH=/etc/ssl/kafka/client.key
# Seconds to wait for the produce ack before a replay reports 502.
KAFKA_PRODUCE_TIMEOUT=15

# Consumer lag is the *consuming service's own* group on the topic it consumes.
# The group id is derived from the topic: cargo-lexical.files -> cargo-lexical
# -> cargo-lexical-service. A topic that breaks the convention just shows no lag.
LAG_GROUP_ID_TEMPLATE={service}-service

# ---- Auth: OIDC Authorization Code, confidential client ----------------------
# Same shape as dlq-triage's AUTH__OIDC_* block, flattened. The browser drives
# only the redirect leg; this process holds the secret and does the exchange.
# No PKCE and no discovery — the SSO issues confidential clients only, and
# Keycloak builds its discovery document from KC_HOSTNAME, so every endpoint is
# derived from the bare realm URL below instead.
#
# Bare realm URL — no /.well-known/openid-configuration suffix. Browser-facing,
# and what the token's `iss` claim carries.
AUTH_OIDC_ISSUER_URL=http://localhost:8083/realms/dls-console
# Set only when the issuer above is unreachable from inside the cluster: the
# browser still redirects there, while this process fetches JWKS and posts the
# token exchange here.
# AUTH_OIDC_INTERNAL_URL=http://keycloak:8080/realms/dls-console
AUTH_OIDC_CLIENT_ID=dls-console
AUTH_OIDC_CLIENT_SECRET=dev-console-secret
# Expected `aud` on the access token. Leave unset unless the realm has an
# audience mapper for this client: Keycloak's stock access token carries
# `aud: account`, so setting this to the client id would reject every token.
# AUTH_OIDC_AUDIENCE=dls-console
# Signing-key cache lifetime, seconds.
AUTH_OIDC_JWKS_TTL=300
# Encrypts the session cookie. Never shared with the IdP — unlike the client
# secret above, this one never leaves the process. Real entropy only:
#   openssl rand -base64 32
AUTH_SECRET=dev-only-change-me-32-bytes-minimum
# PEM CA bundle for the IdP's TLS cert. Required wherever the SSO is signed by
# an internal CA: without it every sign-in fails on certificate verification,
# because node ships its own trust store. This is node's own variable, read at
# process start — mounting the file without setting this does nothing. One knob
# covers both hops, the token POST and the JWKS fetch.
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/idf-ca-bundle.pem
#
# No redirect URI here: the browser derives it as `<origin>/`, and the IdP must
# register exactly that. There is no per-provider callback path any more.

# Dev-only: skip auth entirely and audit every action as DEV_ACTOR.
# NEVER enable in a deployed environment.
DEV_BYPASS=false
DEV_ACTOR=dev@example.com
