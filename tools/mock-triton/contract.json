{
  "_comment": [
    "Captured verbatim from the production Triton, so dev code sees the same",
    "metadata it will see in prod. Refresh by re-running, against the real server:",
    "  GET  /v2                                      -> server",
    "  POST /v2/repository/index                     -> repository_index",
    "  GET  /v2/models/<name>                        -> models[].metadata",
    "  GET  /v2/models/<name>/config                 -> models[].config",
    "Every model prod loads is implemented; a new one is a metadata/config entry",
    "here, a line in repository_index and a stand-in wired into server.py."
  ],

  "server": {
    "name": "triton",
    "version": "2.56.0",
    "extensions": [
      "classification",
      "sequence",
      "model_repository",
      "model_repository(unload_dependents)",
      "schedule_policy",
      "model_configuration",
      "system_shared_memory",
      "cuda_shared_memory",
      "binary_tensor_data",
      "parameters",
      "statistics",
      "trace",
      "logging"
    ]
  },

  "repository_index": [
    { "name": "cargo_reranker", "version": "1", "state": "READY" },
    { "name": "chat-reports-classifier", "version": "1", "state": "READY" },
    { "name": "retrieval_embedder", "version": "1", "state": "READY" },
    { "name": "text-embedding", "version": "1", "state": "READY" }
  ],

