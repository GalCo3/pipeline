{
  "_comment": [
    "Captured verbatim from the production Triton, so dev code sees the same",
    "metadata it will see in prod. Refresh by re-running, against the real server:",
    "  GET  /v2                                      -> server",
    "  POST /v2/repository/index                     -> repository_index",
    "  GET  /v2/models/retrieval_embedder            -> models[].metadata",
    "  GET  /v2/models/retrieval_embedder/config     -> models[].config",
    "Only retrieval_embedder is implemented. The other two models prod loads are",
    "listed in repository_index (they are visible there in prod, and a client that",
    "enumerates models would notice their absence), but have no metadata/config and",
    "reject inference — add them here the same way when something needs them."
  ],

  "server": {
    "name": "triton",
    "version": "2.56.0",
    "extensions": [
      "classification",
      "sequence",
      "model_repository",
      "model_repository(unload_dependents)",
      "schedule_policy",
      "model_configuration",
      "system_shared_memory",
      "cuda_shared_memory",
      "binary_tensor_data",
      "parameters",
      "statistics",
      "trace",
      "logging"
    ]
  },

  "repository_index": [
    { "name": "cargo_reranker", "version": "1", "state": "READY" },
    { "name": "chat-reports-classifier", "version": "1", "state": "READY" },
    { "name": "retrieval_embedder", "version": "1", "state": "READY" }
  ],

  "models": {
    "retrieval_embedder": {
      "metadata": {
        "name": "retrieval_embedder",
        "versions": ["1"],
        "platform": "onnxruntime_onnx",
        "inputs": [
          { "name": "attention_mask", "datatype": "INT64", "shape": [-1, -1] },
          { "name": "input_ids", "datatype": "INT64", "shape": [-1, -1] }
        ],
        "outputs": [
          { "name": "sentence_embedding", "datatype": "FP32", "shape": [-1, 1024] },
          { "name": "token_embeddings", "datatype": "FP32", "shape": [-1, -1, 1024] }
        ]
      },

      "config": {
        "name": "retrieval_embedder",
        "platform": "onnxruntime_onnx",
        "backend": "onnxruntime",
        "runtime": "",
        "version_policy": { "latest": { "num_versions": 1 } },
        "max_batch_size": 16,
        "input": [
          {
            "name": "attention_mask",
            "data_type": "TYPE_INT64",
            "format": "FORMAT_NONE",
            "dims": [-1],
            "is_shape_tensor": false,
            "allow_ragged_batch": false,
            "optional": false,
            "is_non_linear_format_io": false
          },
          {
            "name": "input_ids",
            "data_type": "TYPE_INT64",
            "format": "FORMAT_NONE",
            "dims": [-1],
            "is_shape_tensor": false,
            "allow_ragged_batch": false,
            "optional": false,
            "is_non_linear_format_io": false
          }
        ],
        "output": [
          {
            "name": "sentence_embedding",
            "data_type": "TYPE_FP32",
            "dims": [1024],
            "label_filename": "",
            "is_shape_tensor": false,
            "is_non_linear_format_io": false
          },
          {
            "name": "token_embeddings",
            "data_type": "TYPE_FP32",
            "dims": [-1, 1024],
            "label_filename": "",
            "is_shape_tensor": false,
            "is_non_linear_format_io": false
          }
        ],
        "batch_input": [],
        "batch_output": [],
        "optimization": {
          "priority": "PRIORITY_DEFAULT",
          "input_pinned_memory": { "enable": true },
          "output_pinned_memory": { "enable": true },
          "gather_kernel_buffer_threshold": 0,
          "eager_batching": false
        },
        "instance_group": [
          {
            "name": "retrieval_embedder_0",
            "kind": "KIND_GPU",
            "count": 10,
            "gpus": [0],
            "secondary_devices": [],
            "profile": [],
            "passive": false,
            "host_policy": ""
          }
        ],
        "default_model_filename": "model.onnx",
        "cc_model_filenames": {},
        "metric_tags": {},
        "parameters": { "arena_extend_strategy": { "string_value": "1" } },
        "model_warmup": []
      }
    }
  }
}
